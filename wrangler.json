{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codesk",
  "workers_dev": true,
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "not_found_handling": "none",
    "html_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/mcp",
      "/mcp/*",
      "/ws",
      "/ws/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CODESK_DO",
        "class_name": "CoDesk"
      }
    ]
  },
  "exports": {
    "CoDesk": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}

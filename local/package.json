{
  "name": "codesk-local",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "verify": "npm run lint && npm run build && npm test",
    "test:install": "playwright install chromium",
    "configure": "node scripts/configure.mjs",
    "setup": "node scripts/setup.mjs",
    "plugin:build": "node scripts/plugin.mjs --build-only",
    "plugin:install": "node scripts/plugin.mjs",
    "plugin:list": "codex plugin list",
    "runtime:status": "node scripts/runtime.mjs status",
    "runtime:stop": "node scripts/runtime.mjs stop",
    "runtime:restart": "node scripts/runtime.mjs restart",
    "diagnostics": "node scripts/runtime.mjs diagnostics",
    "verify:tunnel": "node scripts/verify-tunnel.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openai/codex": "0.153.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "playwright": "1.58.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "2.3.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "description": "CoDesk local: SQLite, MCP stdio and a plugin-managed HTTPS/WSS tunnel"
}

{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "strict": true, "noEmit": true, "jsx": "react-jsx",
    "noUnusedLocals": true, "noUnusedParameters": true, "erasableSyntaxOnly": true
  },
  "include": ["src", "server", "vite.config.ts"]
}
